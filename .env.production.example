APP_ENV=production

API_HOST=0.0.0.0
API_PORT=8080

DATABASE_URL=postgres://peakcloud:CHANGE_ME@postgres:5432/peakcloud?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=peakcloud
S3_USE_SSL=false

WEB_URL=https://cloud.example.com
NEXT_PUBLIC_API_URL=https://api.cloud.example.com

SESSION_COOKIE_NAME=peakcloud_session
SESSION_TTL_HOURS=168
SESSION_SECURE=true

MAX_UPLOAD_SIZE_MB=100

HTTP_READ_HEADER_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=15
HTTP_IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10

POSTGRES_USER=peakcloud
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=peakcloud

MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
